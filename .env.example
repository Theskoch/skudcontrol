# Postgres
POSTGRES_USER=skud
POSTGRES_PASSWORD=change_me
POSTGRES_DB=skudcontrol
DATABASE_URL=postgresql://skud:change_me@db:5432/skudcontrol

# Backend
JWT_SECRET=change_me_to_a_long_random_string
APP_TZ=Europe/Moscow
PORT=4000

# Seed
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me

# Public port for the web app. BIND_ADDRESS defaults to loopback-only, since a
# local reverse proxy (e.g. Nginx Proxy Manager) on the same host is expected
# to be the only thing that talks to this port directly and handle HTTPS/domain
# in front of it. Set BIND_ADDRESS=0.0.0.0 only if the reverse proxy runs on a
# different host and needs to reach this one over the network.
WEB_PORT=8080
BIND_ADDRESS=127.0.0.1

# Public HTTPS origin the app is served under once behind the reverse proxy,
# e.g. https://skud.example.com - used to restrict CORS instead of allowing
# any origin. Leave empty for local dev (falls back to allowing any origin).
CORS_ORIGIN=

# Set to true once served over HTTPS via the reverse proxy, so the login
# cookie gets the Secure flag. Leave false for local http://localhost testing.
COOKIE_SECURE=false

# Folder watched for the ACS export (Report.html). The client overwrites this
# file in place on its own schedule; the backend rechecks it every hour at :30.
# Point this at wherever the real export lands (a network share, another app's
# output folder, etc.) - defaults to the project's own Report/ folder for now.
REPORT_HOST_DIR=./Report

# Shared secret for the Wi-Fi session ingestion endpoint (POST /api/network-sessions/ingest),
# used by a future UniFi/MikroTik poller - separate from admin login.
NETWORK_INGEST_TOKEN=change_me_to_a_long_random_string

# UniFi Site Manager API (https://api.ui.com) - put your production API key here.
# Only ever used for read-only GET requests (client/session polling), never writes.
UNIFI_API_KEY=
UNIFI_API_BASE_URL=https://api.ui.com
UNIFI_SITE_ID=
UNIFI_CONSOLE_ID=
